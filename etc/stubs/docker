#!/bin/sh
# Stand-in for `docker` on the GO AI hub while the ODK toolchain is not available
# (geneontology/go-jupyter#74). go-ontology's run.sh and odk-run.sh call `docker run
# obolibrary/odkfull ...`; without this file that fails with "command not found" and
# the agent starts improvising. This prints the situation and fails cleanly.
#
# REMOVE THIS FILE WHEN DOCKER IS INSTALLED: /usr/local/bin comes before /usr/bin on
# PATH, so it would shadow the real docker.
cat >&2 <<'MSG'
The ontology build tools are not available on the GO AI hub yet.

  What this means: `robot`, the go-ontology Makefile targets (make test, make
  reasoned.ofn, ...) and the reasoner run inside the ODK container, and this
  machine cannot run that container for now (memory and setup; status:
  https://github.com/geneontology/go-jupyter/issues/74).

  What still works here: reading and editing src/ontology, term lookups
  (runoak, obo-grep.pl), design guidance, and preparing a pull request.

  Where the checks run: open the pull request to geneontology/go-ontology;
  its CI runs the full QC and reasoning on your branch.
MSG
exit 1
