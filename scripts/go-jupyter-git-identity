#!/usr/bin/env bash
#
# go-jupyter-git-identity — seed git user.name / user.email for a hub account from
# the account's GitHub profile, so the first `git commit` in a session does not
# stop with "Author identity unknown" (geneontology/go-jupyter#48).
#
#   * ONLY SETS WHAT IS UNSET. A user.name or user.email the curator already has
#     in ~/.gitconfig is never changed.
#   * Source: the public GitHub user API, no token (60 requests/hour per IP; first
#     logins are rare and --all is a one-off). name = the profile name, or the
#     login if none; email = the public profile email if any, else GitHub's
#     noreply address <id>+<login>@users.noreply.github.com, which GitHub links
#     to the account.
#   * Applies to accounts that arrived through GitHub OAuth, i.e. names listed in
#     /etc/jupyterhub/github_allowed_users.txt. Side-door (PAM) accounts are
#     skipped and logged: their GitHub login is not known here.
#   * If the API cannot be reached, falls back to name = login and
#     email = <login>@users.noreply.github.com so commits work, and logs the
#     fallback (GitHub links that older form only for accounts from before
#     2017-07-18; a later run does not revisit it because the values are set).
#
# Usage: go-jupyter-git-identity <user> [--dry-run]
#        go-jupyter-git-identity --all [--dry-run]     (every seeded home)
#
# Callers: the hub's first-login seed (jupyterhub_config.py), operators. Exit 0
# unless the arguments are wrong.
#
set -euo pipefail

ALLOWED=/etc/jupyterhub/github_allowed_users.txt
API=https://api.github.com/users
DRY=0
ALL=0
USER_NAME=""
while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run) DRY=1 ;;
        --all)     ALL=1 ;;
        -h|--help) sed -n '2,30p' "$0"; exit 0 ;;
        -*)        echo "unknown option: $1" >&2; exit 2 ;;
        *)         USER_NAME="$1" ;;
    esac
    shift
done
[ "$(id -u)" -eq 0 ] || { echo "must run as root (try: sudo $0 $*)" >&2; exit 2; }
[ "$ALL" -eq 1 ] || [ -n "$USER_NAME" ] || { echo "usage: $0 <user> [--dry-run] | --all [--dry-run]" >&2; exit 2; }

log() { logger -t go-jupyter-git-identity -- "$*"; echo "  $*"; }

seed_one() {
    local user="$1" home name email id json
    home="$(getent passwd "$user" | cut -d: -f6)"
    [ -n "$home" ] && [ -d "$home" ] || { log "$user: no home directory; skipped"; return 0; }
    [[ "$user" =~ ^[A-Za-z0-9_][A-Za-z0-9_-]{0,38}$ ]] || { log "$user: not a usable login; skipped"; return 0; }

    as_user() { runuser -u "$user" -- env HOME="$home" "$@"; }
    local have_name=0 have_email=0
    as_user git config --global --get user.name  >/dev/null 2>&1 && have_name=1
    as_user git config --global --get user.email >/dev/null 2>&1 && have_email=1
    if [ "$have_name" -eq 1 ] && [ "$have_email" -eq 1 ]; then return 0; fi

    if ! [ -f "$ALLOWED" ] || ! grep -qix -- "$user" "$ALLOWED"; then
        log "$user: not a GitHub OAuth account (not in $ALLOWED); identity left for the user to set"
        return 0
    fi

    name=""; email=""
    if json="$(curl -fsS -m 8 -H 'Accept: application/vnd.github+json' -H 'User-Agent: go-jupyter-git-identity' "$API/$user" 2>/dev/null)"; then
        # email first (never contains spaces), then the name (may contain spaces).
        read -r email name < <(printf '%s' "$json" | python3 -c '
import json, sys
d = json.load(sys.stdin)
login = d.get("login") or sys.argv[1]
name = " ".join((d.get("name") or "").split()) or login
email = (d.get("email") or "").strip() or "%s+%s@users.noreply.github.com" % (d.get("id"), login)
print(email, name)' "$user" 2>/dev/null || true)
    fi
    if [ -z "$name" ] || [ -z "$email" ]; then
        name="$user"; email="$user@users.noreply.github.com"
        log "$user: GitHub API not reachable; falling back to $name <$email>"
    fi

    if [ "$have_name" -eq 0 ]; then
        if [ "$DRY" -eq 1 ]; then echo "  would: git config --global user.name '$name' (as $user)"; else
            as_user git config --global user.name "$name"; fi
    fi
    if [ "$have_email" -eq 0 ]; then
        if [ "$DRY" -eq 1 ]; then echo "  would: git config --global user.email '$email' (as $user)"; else
            as_user git config --global user.email "$email"; fi
    fi
    if [ "$DRY" -eq 1 ]; then log "$user: git identity (dry-run) would be set to $name <$email>"; else log "$user: git identity set to $name <$email>"; fi
}

if [ "$ALL" -eq 1 ]; then
    while IFS=: read -r name _ uid _ _ home _; do
        [ "${uid:-0}" -ge 1000 ] 2>/dev/null || continue
        case "$name" in ubuntu | nobody) continue ;; esac
        [ -f "$home/.seeded" ] || continue
        seed_one "$name"
    done < <(getent passwd)
else
    seed_one "$USER_NAME"
fi
exit 0
