#!/usr/bin/env bash
#
# go-jupyter-link-skills — give one user a checkout of each skill source and link
# its skills into ~/.claude/skills.
#
# The model (kltm, 2026-09-28): skills live in their own repositories
# (geneontology/go-skills first); go-jupyter is only the box. Each user's home
# holds a real git clone of every source listed in /opt/go-jupyter/skill-sources.txt
# (~/<repo name>), owned by the user, and ~/.claude/skills/<skill> is a relative
# symlink into that clone. Claude Code follows the link and watches the target,
# so an edit in the clone is live in the session.
#
#   * FAST-FORWARD ONLY WHEN CLEAN. A clone that is on <ref> with no local changes
#     is fetched and fast-forwarded. A clone on another branch, or with local
#     changes, is left exactly as it is (and logged): that is a curator editing a
#     skill, and their work is the raw material for the future "dreaming" process
#     that turns local skill edits into go-skills PRs.
#   * A REAL DIRECTORY IS REPLACED ONLY WHEN IT IS AN UNMODIFIED TEMPLATE COPY.
#     If ~/.claude/skills/<skill> is a directory rather than a link, it is compared
#     with the go-jupyter template's copy of the same skill
#     (user-templates/<tmpl>/.claude/skills/<skill>, <tmpl> from ~/.seeded). Byte-
#     identical: it is moved to ~/.go-jupyter/refresh-backups/<ts>/ and the link
#     takes its place (that is how a skill moves out of the template: land it in
#     go-skills, let this run, THEN delete the template copy). Anything else (a
#     copy the curator changed, a skill they authored, no template copy to compare
#     with) is left as it is and logged. Nothing here deletes a directory.
#   * LINK HYGIENE. A link that points into one of our clones but whose target no
#     longer exists (skill removed upstream) is removed. Links elsewhere are not
#     touched. Two sources offering the same skill name: the source listed first
#     in skill-sources.txt wins, the other is logged and not linked.
#   * SOURCE OPTIONS (skill-sources.txt, after <url> <ref> <subdir>):
#       sparse=<dir>[,<dir>...]  blobless partial clone (--filter=blob:none) with
#                                a cone sparse checkout of these directories plus
#                                <subdir>; root-level files come along. For big
#                                repositories such as go-ontology (208 MB this
#                                way, 2026-09-29, against gigabytes in full).
#       exclude=<skill>[,...]    skills of this source not to link (e.g. ones
#                                that need tools the box does not have).
#   * Respects ~/.go-jupyter/hold-skills (skips the user).
#
# Usage: go-jupyter-link-skills <user> [--no-fetch] [--sources FILE] [--dry-run]
#                                      [--template-skills DIR]
#        go-jupyter-link-skills --home DIR [...]     (non-root testing only)
#   --template-skills DIR  the template skills directory to compare real
#                          directories with (default: derived from ~/.seeded;
#                          none in --home mode unless given)
#
# Callers: go-jupyter-sync-skills (timer), go-jupyter-refresh-user, and the hub's
# first-login seed (jupyterhub_config.py). Exit 0 unless the arguments are wrong.
#
set -euo pipefail

SOURCES=/opt/go-jupyter/skill-sources.txt
TEMPLATE_ROOT=/opt/go-jupyter/user-templates
TEMPLATE_SKILLS=""
FETCH=1
DRY=0
USER_NAME=""
HOME_OVERRIDE=""
TS="$(date +%Y-%m-%dT%H%M%S)"
while [ $# -gt 0 ]; do
    case "$1" in
        --no-fetch) FETCH=0 ;;
        --dry-run)  DRY=1 ;;
        --sources)  SOURCES="${2:-}"; shift ;;
        --home)     HOME_OVERRIDE="${2:-}"; shift ;;
        --template-skills) TEMPLATE_SKILLS="${2:-}"; shift ;;
        -h|--help)  sed -n '2,48p' "$0"; exit 0 ;;
        -*)         echo "unknown option: $1" >&2; exit 2 ;;
        *)          USER_NAME="$1" ;;
    esac
    shift
done

log() { if [ "$(id -u)" -eq 0 ]; then logger -t go-jupyter-link-skills -- "$*"; fi; echo "  $*"; }
run() { if [ "$DRY" -eq 1 ]; then echo "  would: $*"; else "$@"; fi; }

if [ -n "$HOME_OVERRIDE" ]; then
    [ "$(id -u)" -ne 0 ] || { echo "--home is for non-root testing only" >&2; exit 2; }
    home="$HOME_OVERRIDE"; USER_NAME="$(id -un)"
    as_user() { "$@"; }
    own() { :; }
else
    [ "$(id -u)" -eq 0 ] || { echo "must run as root (try: sudo $0 $*)" >&2; exit 2; }
    [ -n "$USER_NAME" ] || { echo "usage: $0 <user> [--no-fetch] [--sources FILE] [--dry-run]" >&2; exit 2; }
    home="$(getent passwd "$USER_NAME" | cut -d: -f6)"
    [ -n "$home" ] && [ -d "$home" ] || { echo "no home directory for $USER_NAME" >&2; exit 2; }
    as_user() { runuser -u "$USER_NAME" -- env HOME="$home" "$@"; }
    own() { chown -h "$USER_NAME:$USER_NAME" "$@"; }
fi

[ -f "$SOURCES" ] || { log "no sources file at $SOURCES; nothing to do"; exit 0; }
if [ -e "$home/.go-jupyter/hold-skills" ]; then log "hold $USER_NAME (hold-skills present)"; exit 0; fi
if [ -z "$TEMPLATE_SKILLS" ] && [ -z "$HOME_OVERRIDE" ]; then
    tmpl="$(head -n1 "$home/.seeded" 2>/dev/null | tr -d '[:space:]')"
    [ -n "$tmpl" ] || tmpl=researcher
    TEMPLATE_SKILLS="$TEMPLATE_ROOT/$tmpl/.claude/skills"
fi

skills_dir="$home/.claude/skills"
run mkdir -p "$skills_dir"
# Every source's clone name, known before the loop: a link that points into a
# LATER source must still be recognised as ours (so an earlier source can take
# the name over: first listed wins) and not mistaken for a foreign link.
declare -A clone_dirs=()
while read -r url _; do
    case "$url" in ''|'#'*) continue ;; esac
    clone_dirs["$(basename "$url" .git)"]=1
done < "$SOURCES"
declare -A seen_sources=()

while read -r url ref subdir rest; do
    case "$url" in ''|'#'*) continue ;; esac
    name="$(basename "$url" .git)"
    clone="$home/$name"
    seen_sources["$name"]=1
    sparse=""; exclude=""
    for kv in $rest; do
        case "$kv" in
            sparse=*)  sparse="${kv#sparse=}" ;;
            exclude=*) exclude="${kv#exclude=}" ;;
            '#'*)      break ;;
            *)         log "$USER_NAME: unknown option '$kv' for $url; ignored" ;;
        esac
    done

    if [ ! -d "$clone/.git" ]; then
        if [ -e "$clone" ]; then log "$USER_NAME: $clone exists and is not a git checkout; skipping source $url"; continue; fi
        if [ -n "$sparse" ]; then
            # shellcheck disable=SC2086
            dirs="$(printf '%s' "$subdir,$sparse" | tr ',' ' ')"
            log "$USER_NAME: cloning $url ($ref) into $clone (blobless, sparse: $dirs)"
            if [ "$DRY" -eq 1 ]; then echo "  would: git clone --filter=blob:none --no-checkout --branch $ref $url $clone; sparse-checkout set --cone $dirs; checkout $ref"; continue; fi
            # shellcheck disable=SC2086
            if ! { as_user git clone -q --filter=blob:none --no-checkout --branch "$ref" "$url" "$clone" \
                   && as_user git -C "$clone" sparse-checkout set --cone $dirs \
                   && as_user git -C "$clone" checkout -q "$ref"; } 2>/dev/null; then
                log "$USER_NAME: sparse clone of $url failed; removing the partial clone, will retry next run"
                as_user rm -rf -- "$clone"; continue
            fi
        else
            log "$USER_NAME: cloning $url ($ref) into $clone"
            if [ "$DRY" -eq 1 ]; then echo "  would: git clone --branch $ref $url $clone"; continue; fi
            if ! as_user git clone -q --branch "$ref" "$url" "$clone" 2>/dev/null; then
                log "$USER_NAME: clone of $url failed; will retry next run"; continue
            fi
        fi
    elif [ "$FETCH" -eq 1 ]; then
        branch="$(as_user git -C "$clone" symbolic-ref --short -q HEAD 2>/dev/null || echo DETACHED)"
        dirty="$(as_user git -C "$clone" status --porcelain 2>/dev/null | head -1)"
        if [ "$branch" = "$ref" ] && [ -z "$dirty" ]; then
            if [ "$DRY" -eq 1 ]; then echo "  would: fast-forward $clone to origin/$ref"; else
                as_user git -C "$clone" fetch -q origin "$ref" 2>/dev/null \
                    && as_user git -C "$clone" merge -q --ff-only FETCH_HEAD 2>/dev/null \
                    || log "$USER_NAME: could not fast-forward $clone; left as is"
            fi
        else
            log "$USER_NAME: $clone left alone (branch=$branch${dirty:+, local changes}) — curator edit in progress"
        fi
    fi

    src="$clone/$subdir"
    [ -d "$src" ] || { log "$USER_NAME: $src missing in $name; no skills linked from it"; continue; }
    for d in "$src"/*/; do
        [ -f "$d/SKILL.md" ] || continue
        skill="$(basename "$d")"
        dst="$skills_dir/$skill"
        rel="../../$name/$subdir/$skill"
        case ",$exclude," in *",$skill,"*)
            if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$rel" ]; then
                log "$USER_NAME: $skill is now excluded for $name; removing its link"; run rm -f "$dst"
            fi
            continue ;;
        esac
        if [ -L "$dst" ]; then
            cur="$(readlink "$dst")"
            if [ "$cur" != "$rel" ]; then
                curfirst="${cur#../../}"; curfirst="${curfirst%%/*}"
                if [ "$curfirst" = "$name" ] || { [ -n "${clone_dirs[$curfirst]:-}" ] && [ ! -e "$dst" ]; }; then
                    # ours and stale, or ours and dangling (its provider dropped the skill): retarget
                    run ln -sfn "$rel" "$dst"; own "$dst"; log "$USER_NAME: relinked $skill -> $rel"
                elif [ -n "${seen_sources[$curfirst]:-}" ]; then
                    log "$USER_NAME: $skill is already provided by $curfirst (listed first); $name's copy not linked"
                elif [ -n "${clone_dirs[$curfirst]:-}" ]; then
                    # points into a source listed AFTER this one: this one wins
                    run ln -sfn "$rel" "$dst"; own "$dst"; log "$USER_NAME: $skill now from $name (listed before $curfirst)"
                else
                    log "$USER_NAME: $skill links elsewhere ($cur); left alone"
                fi
            fi
        elif [ -d "$dst" ] && [ -n "$TEMPLATE_SKILLS" ] && [ -d "$TEMPLATE_SKILLS/$skill" ] \
             && diff -rq "$TEMPLATE_SKILLS/$skill" "$dst" >/dev/null 2>&1; then
            # Unmodified copy of the template: nothing is lost by replacing it, and
            # the copy is kept anyway (same place refresh-user keeps what it supersedes).
            bk="$home/.go-jupyter/refresh-backups/$TS/.claude/skills"
            log "$USER_NAME: $skill is an unmodified template copy; kept under $bk, replaced by the $name link"
            run as_user mkdir -p "$bk"
            run as_user mv "$dst" "$bk/$skill"
            run ln -s "$rel" "$dst"; own "$dst"
        elif [ -e "$dst" ]; then
            log "$USER_NAME: $skill is a real directory in ~/.claude/skills (not an unmodified template copy); not replaced by the $name link"
        else
            run ln -s "$rel" "$dst"; own "$dst"; log "$USER_NAME: linked $skill -> $rel"
        fi
    done
done < "$SOURCES"

# Remove links into our clones whose target vanished (skill removed upstream).
for l in "$skills_dir"/*; do
    [ -L "$l" ] || continue
    t="$(readlink "$l")"
    first="${t#../../}"; first="${first%%/*}"
    if [ -n "${clone_dirs[$first]:-}" ] && [ ! -e "$l" ]; then
        log "$USER_NAME: removing dangling link $(basename "$l") -> $t"; run rm -f "$l"
    fi
done
exit 0
