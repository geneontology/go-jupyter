#!/usr/bin/env python3
"""go-jupyter-report-marks — attach a curator's /report records to the Langfuse
trace of the turn they were made in (#25, #28).

go-jupyter-trace-sync runs this as root once per account, after the account's
transcripts have been forwarded, inside a subshell that holds the Langfuse keys
(LANGFUSE_PUBLIC_KEY, LANGFUSE_SECRET_KEY, LANGFUSE_BASE_URL):

    go-jupyter-report-marks --user <langfuse user id> --reports <archived
        ~/.go-jupyter/reports copy> --mirror <the account's redacted mirror
        of ~/.claude/projects> --state-file <the hook's langfuse_state.json>
        --sent-dir <where one marker per handled record goes>
        --redactor <go-jupyter-redact-transcript> [--max-age-secs N] [--dry-run]

For every regular file <reports>/*.json with no marker under <sent-dir> (the
/report skill in geneontology/go-skills writes them: version 1, with
session_id, turn_uuid, category, note, context, issue_url, skill, timestamp;
the curator owns the file, so every field is untrusted):

  1. find the turn, the way the hook groups rows: in the mirrored transcript
     <mirror>/<slug>/<session_id>.jsonl, take the row whose uuid is turn_uuid
     (the last assistant row when the record was written) and scan back in
     file order to the nearest row that opens a turn (a user row that is not
     a tool result, not an isMeta injection, not a task notification and not
     the interrupt marker); that row's number is in the hook's turn_numbers
     for the transcript; the trace id is sha256("<session>:<turn>")[:32],
     the hook's own formula under CC_LANGFUSE_TRACE_SEED;
  2. post one score with the synchronous public API (POST /api/public/scores,
     which raises on any failure; not the trace GET bucket): name
     "curator-report", categorical value = the category, comment = the
     curator's note, the agent's context line and the issue URL, note and
     context through the redactor; metadata = record file, turn uuid, skill,
     time of the report; the score id is sha256("curator-report:<user>:
     <record file>")[:32], so a repeat after a failure updates the same score;
  3. write the marker, "<time> <trace|session|none> <id> <category>", only
     after the API accepted the score, so a record is never marked and lost.

Until a record is --max-age-secs old (default a day) it is deferred, without
a marker, while its transcript is not mirrored yet, its turn_uuid is not in
the transcript yet, or the hook has not numbered the turn yet; after that it
is scored on the session (Langfuse shows session scores in the Sessions tab,
not in the trace list). A record whose turn opener was copied from another
session (a resumed session; the hook never numbers those) goes on the
session at once; one with no usable session id, or unreadable once it is
old, gets a "none" marker. Exit 1 if a post failed; --dry-run prints what
would be posted and needs no keys.
"""
import argparse
import datetime
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import sys

MAX_COMMENT = 4000
INTERRUPT_MARKER = "[Request interrupted by user]"   # the hook's INTERRUPTED_TURN_MARKER, exactly
CATEGORIES = ("error", "wrong-tool", "idea", "complaint", "praise", "other")
ID_RE = re.compile(r"[A-Za-z0-9_-]{1,80}")


def load_redactor(path):
    # The redactor has no .py suffix, so name its loader explicitly; no
    # bytecode cache next to a system script.
    sys.dont_write_bytecode = True
    loader = importlib.machinery.SourceFileLoader("go_jupyter_redactor", path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod.redact_line


# --- row classification, mirroring the hook (get_content_from_row,
# extract_text_from_content, get_user_or_assistant_role_from_row,
# is_tool_result, add_injected_context_row, is_task_notification_row,
# is_interrupted_turn_row, is_row_from_another_session).

def row_content(d):
    m = d.get("message")
    if isinstance(m, dict):
        return m.get("content")
    return d.get("content")


def row_text(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = []
        for x in content:
            if isinstance(x, dict) and x.get("type") == "text":
                parts.append(x.get("text", ""))
            elif isinstance(x, str):
                parts.append(x)
        return "\n".join(p for p in parts if p)
    return ""


def row_role(d):
    t = d.get("type")
    if t in ("user", "assistant"):
        return t
    m = d.get("message")
    if isinstance(m, dict) and m.get("role") in ("user", "assistant"):
        return m["role"]
    return None


def starts_turn(d):
    if row_role(d) != "user" or d.get("isMeta"):
        return False
    c = row_content(d)
    if isinstance(c, list) and any(isinstance(b, dict) and b.get("type") == "tool_result" for b in c):
        return False
    origin = d.get("origin")
    if isinstance(origin, dict) and origin.get("kind") == "task-notification":
        return False
    text = row_text(c).lstrip()
    return not (text.startswith("<task-notification>") or text.startswith(INTERRUPT_MARKER))


def from_other_session(d, session_id):
    s = d.get("sessionId")
    return isinstance(s, str) and bool(s) and s != session_id


def find_transcript(mirror, session_id):
    """<mirror>/<slug>/<session_id>.jsonl, inside the mirror, or None."""
    root = os.path.realpath(mirror)
    try:
        slugs = os.listdir(mirror)
    except OSError:
        return None
    for slug in slugs:
        p = os.path.join(mirror, slug, f"{session_id}.jsonl")
        if os.path.isfile(p) and os.path.realpath(p).startswith(root + os.sep):
            return p
    return None


def turn_opener(transcript_path, turn_uuid):
    """(uuid of the user row that opened the turn containing turn_uuid, that
    row) in file order, as the hook groups turns; (None, None) if turn_uuid
    is not in the transcript or no opener precedes it."""
    opener = None
    with open(transcript_path, encoding="utf-8", errors="surrogateescape") as fh:
        for line in fh:
            try:
                d = json.loads(line)
            except ValueError:
                continue
            if not isinstance(d, dict):
                continue
            if starts_turn(d) and isinstance(d.get("uuid"), str):
                opener = d
            if d.get("uuid") == turn_uuid:
                return (opener["uuid"], opener) if opener else (None, None)
    return None, None


def turn_number(state_file, session_id, mirror_path, user_row_uuid):
    try:
        with open(state_file) as fh:
            state = json.load(fh)
    except Exception:
        return None
    key = hashlib.sha256(f"{session_id}::{mirror_path}".encode("utf-8")).hexdigest()
    n = ((state.get(key) or {}).get("turn_numbers") or {}).get(user_row_uuid)
    return n if isinstance(n, int) and n > 0 else None


def trace_id(session_id, turn):
    return hashlib.sha256(f"{session_id}:{turn}".encode("utf-8")).hexdigest()[:32]


def record_age(rec, path, now):
    """Seconds since the record was made: its timestamp, else the file's mtime."""
    ts = rec.get("timestamp")
    try:
        t = datetime.datetime.fromisoformat(str(ts).replace("Z", "+00:00"))
        if t.tzinfo is None:
            t = t.replace(tzinfo=datetime.timezone.utc)
    except (ValueError, TypeError):
        t = datetime.datetime.fromtimestamp(os.path.getmtime(path), datetime.timezone.utc)
    return (now - t).total_seconds()


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--user", required=True, help="Langfuse user id (github:<login> or local:<host>:<user>)")
    ap.add_argument("--reports", required=True)
    ap.add_argument("--mirror", required=True)
    ap.add_argument("--state-file", required=True)
    ap.add_argument("--sent-dir", required=True)
    ap.add_argument("--redactor", required=True)
    ap.add_argument("--max-age-secs", type=int, default=86400)
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args()

    if not os.path.isdir(args.reports):
        return 0
    pending = sorted(f for f in os.listdir(args.reports)
                     if f.endswith(".json") and not os.path.exists(os.path.join(args.sent_dir, f)))
    if not pending:
        return 0
    redact = load_redactor(args.redactor)
    now = datetime.datetime.now(datetime.timezone.utc)
    stamp = now.strftime("%Y-%m-%dT%H:%M:%SZ")
    scores = None
    if not args.dry_run:
        os.makedirs(args.sent_dir, mode=0o700, exist_ok=True)
        from langfuse import Langfuse  # keys from the environment
        scores = Langfuse(tracing_enabled=False).api.scores
    failed = 0

    def mark(name, kind, ident, category):
        if not args.dry_run:
            with open(os.path.join(args.sent_dir, name), "w") as fh:
                fh.write(f"{stamp} {kind} {ident or '-'} {category}\n")

    for name in pending:
        path = os.path.join(args.reports, name)
        if os.path.islink(path) or not os.path.isfile(path):
            print(f"  report {args.user} {name}: not a regular file; marked, not posted")
            mark(name, "none", "", "-")
            continue
        try:
            with open(path, encoding="utf-8") as fh:
                rec = json.load(fh)
            if not isinstance(rec, dict):
                raise ValueError("not a JSON object")
        except Exception as e:
            old = (now.timestamp() - os.path.getmtime(path)) > args.max_age_secs
            print(f"  report {args.user} {name}: unreadable ({e}); " + ("marked, not posted" if old else "retried next run"))
            if old:
                mark(name, "none", "", "unreadable")
            continue
        sid = rec.get("session_id"); tu = rec.get("turn_uuid")
        sid = sid if isinstance(sid, str) and ID_RE.fullmatch(sid) else None
        tu = tu if isinstance(tu, str) and ID_RE.fullmatch(tu) else None
        category = rec.get("category") if rec.get("category") in CATEGORIES else "other"
        comment = redact(str(rec.get("note") or "")).strip()
        if rec.get("context"):
            comment += "\n\n[agent context] " + redact(str(rec["context"])).strip()
        if rec.get("issue_url"):
            comment += "\n\n[issue] " + str(rec["issue_url"]).strip()
        comment = comment[:MAX_COMMENT]
        metadata = {"record": name, "turn_uuid": tu, "skill": str(rec.get("skill") or "")[:80] or None,
                    "reported_at": str(rec.get("timestamp") or "")[:40] or None}
        old = record_age(rec, path, now) > args.max_age_secs

        target = None   # ("trace", id) | ("session", id) | ("none", "")
        why = ""
        if sid and tu:
            tpath = find_transcript(args.mirror, sid)
            urow, opener = turn_opener(tpath, tu) if tpath else (None, None)
            if not tpath:
                why = "transcript not mirrored yet"
            elif not urow:
                why = "turn not in the mirrored transcript yet"
            elif from_other_session(opener, sid):
                target = ("session", sid); why = "turn copied from another session; on the session"
            else:
                n = turn_number(args.state_file, sid, tpath, urow)
                if n is not None:
                    target = ("trace", trace_id(sid, n))
                else:
                    why = "turn not numbered by the hook yet"
            if target is None:
                if not old:
                    print(f"  report {args.user} {name}: {why}; deferred")
                    continue
                target = ("session", sid); why += "; on the session (record older than max age)"
        elif sid:
            target = ("session", sid); why = "no usable turn id; on the session"
        else:
            target = ("none", ""); why = "no usable session id; not posted"

        kind, ident = target
        if kind == "none":
            print(f"  report {args.user} {name}: {category}; {why}; the archived copy is all there is")
            mark(name, kind, ident, category)
            continue
        if args.dry_run:
            print(f"  report {args.user} {name}: would post {category} on {kind} {ident} {why}".rstrip())
            continue
        score_id = hashlib.sha256(f"curator-report:{args.user}:{name}".encode("utf-8")).hexdigest()[:32]
        where = {"trace_id": ident} if kind == "trace" else {"session_id": ident}
        try:
            scores.create(id=score_id, name="curator-report", value=category, data_type="CATEGORICAL",
                          comment=comment or None, metadata=metadata, **where)
        except Exception as e:
            failed += 1
            print(f"  report {args.user} {name}: post failed ({type(e).__name__}: {str(e)[:200]})")
            continue
        mark(name, kind, ident, category)
        print(f"  report {args.user} {name}: posted {category} on {kind} {ident} {why}".rstrip())
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
