#!/usr/bin/env bash
#
# go-jupyter-sync-skills — keep every curator's skills and news current.
#
# Runs as root on a systemd timer (~5 min). Two things are delivered:
#
#   skills:  each skill SOURCE listed in /opt/go-jupyter/skill-sources.txt
#            (geneontology/go-skills first) is checked out ONCE, root-owned, under
#            /var/lib/go-jupyter/skill-sources/<name> (the store), and every home's
#            ~/.claude/skills/<skill> is a symlink into it. The per-user work is
#            go-jupyter-link-skills; this script fetches the store when a source's
#            ref moved (one ls-remote per source per tick) and runs the per-user
#            link pass on EVERY tick, so a link someone removed or replaced is back
#            within minutes (kltm, 2026-10-14; #87). A source marked `workspace`
#            (go-ontology) also keeps a per-user clone for editing the repository
#            itself; that clone is fast-forwarded only on ticks where its ref moved.
#   news:    user-templates/<tmpl>/news/ -> ~/.go-jupyter/news/ (hard mirror; the
#            per-user "seen" marker lives outside that directory on purpose).
#
# Template-carried skills (user-templates/<tmpl>/.claude/skills/; since 2026-09-28
# only the tutorial's workshop-specific exercise/recap, kept out of go-skills by
# decision) are mirrored per skill directory, never with a whole-directory
# --delete, so they cannot remove links or curator-authored skills.
#
# Design notes that still hold from the rsync era:
#   * NEVER DESTRUCTIVE. Anything a mirror overwrites is preserved under
#     ~user/.go-jupyter/refresh-backups/<timestamp>/; a curator's copy that a
#     canonical skill displaces goes to ~user/.go-jupyter/skill-overrides/ (see
#     link-skills). Nothing here deletes a real directory under ~/.claude/skills.
#   * EXPLICIT ESCAPE HATCH. `touch ~/.go-jupyter/hold-skills` makes this skip that
#     user (and log it). Delete the file to resume.
#   * NO HUB RESTART. Skill descriptions load at `claude` launch; a skill's body is
#     read when invoked and the skills directories are watched, so a running
#     session runs new text on its next invoke (Claude Code docs, 2026-09-25). The
#     template CLAUDE.md/README/.bashrc/.mcp.json are go-jupyter-refresh-user's.
#
# Usage: go-jupyter-sync-skills [--force]
#   --force   fetch the store and run the full per-user pass now regardless of
#             what moved.
#
set -euo pipefail

REPO=/opt/go-jupyter
SOURCES="$REPO/skill-sources.txt"
STATE=/var/lib/go-jupyter/skill-sources.state   # "<url> <ref> <sha>" per source, last seen
LINK=/usr/local/sbin/go-jupyter-link-skills
SKILL_PATHSPEC='user-templates/*/.claude/skills/'
NEWS_PATHSPEC='user-templates/*/news/'
FORCE=0
[ "${1:-}" = "--force" ] && FORCE=1
# `--` terminates logger's option parsing: without it a message that happens to
# start with "--" is read as a flag and (under set -e) kills the run.
log() { logger -t go-jupyter-sync-skills -- "$*"; }

[ "$(id -u)" -eq 0 ] || { echo "must run as root (try: sudo $0 $*)" >&2; exit 1; }
cd "$REPO" || { log "no $REPO checkout"; exit 0; }

# 1. Did go-jupyter's own template (skills copies, news, the sources list) move?
repo_changed=0
git fetch -q origin main 2>/dev/null || log "git fetch of $REPO failed; continuing with the checkout as is"
OLD="$(git rev-parse HEAD)"
NEW="$(git rev-parse origin/main 2>/dev/null || echo "$OLD")"
if [ "$OLD" != "$NEW" ]; then
    # Quoted on purpose: git expands the wildcards against both commits; the
    # shell would expand them against the working tree at OLD and miss a
    # template directory that first appears in NEW.
    if ! git diff --quiet "$OLD" "$NEW" -- "$SKILL_PATHSPEC" "$NEWS_PATHSPEC" skill-sources.txt; then
        repo_changed=1
    fi
    git merge --ff-only -q origin/main || { log "ff-only merge failed (drift in $REPO?); skipping"; exit 0; }
fi

# 2. Did any skill source's ref move? One ls-remote per source per tick; users'
#    clones fetch only when it did.
sources_changed=0
mkdir -p "$(dirname "$STATE")"; touch "$STATE"
newstate=""
if [ -f "$SOURCES" ]; then
    while read -r url ref _; do
        case "$url" in ''|'#'*) continue ;; esac
        sha="$(git ls-remote -q "$url" "refs/heads/$ref" 2>/dev/null | cut -f1 || true)"
        [ -n "$sha" ] || { log "ls-remote failed for $url $ref; treating as unchanged"; sha="$(awk -v u="$url" -v r="$ref" '$1==u && $2==r {print $3}' "$STATE")"; }
        old="$(awk -v u="$url" -v r="$ref" '$1==u && $2==r {print $3}' "$STATE")"
        [ "$sha" = "$old" ] || sources_changed=1
        newstate+="$url $ref $sha"$'\n'
    done < "$SOURCES"
fi

# 3. Is the store incomplete (first boot, or a clone that failed)? link-skills
#    creates a missing checkout itself, but only a fetch brings an old one up to
#    date, so an incomplete store is treated like a moved ref.
store_missing=0
STORE_DIR=/var/lib/go-jupyter/skill-sources
if [ -f "$SOURCES" ]; then
    while read -r url _ subdir _; do
        case "$url" in ''|'#'*) continue ;; esac
        d="$STORE_DIR/$(basename "$url" .git)"
        [ -d "$d/.git" ] && [ -d "$d/$subdir" ] || { store_missing=1; break; }
    done < "$SOURCES"
fi

# The per-user link pass runs every tick (cheap: readlinks, no network). The
# store fetch, the template mirror and the news mirror run only when something
# moved, or with --force; so does the run log line, to keep quiet ticks quiet.
full=0
if [ "$FORCE" -eq 1 ] || [ "$repo_changed" -eq 1 ] || [ "$sources_changed" -eq 1 ] || [ "$store_missing" -eq 1 ]; then
    full=1
    log "run: template=${OLD:0:7}->${NEW:0:7} repo_changed=$repo_changed sources_changed=$sources_changed store_missing=$store_missing force=$FORCE"
fi
if [ "$full" -eq 1 ] && [ -x "$LINK" ]; then
    "$LINK" --update-store --sources "$SOURCES" >/dev/null || log "store update failed; linking against the store as it is"
fi

TS="$(date +%Y-%m-%dT%H%M%S)"
mirrored=0
held=0
while IFS=: read -r name _ uid _ _ home _; do
    [ "${uid:-0}" -ge 1000 ] 2>/dev/null || continue
    case "$name" in ubuntu | nobody) continue ;; esac
    [ -f "$home/.seeded" ] || continue

    if [ -e "$home/.go-jupyter/hold-skills" ]; then
        log "hold $name (hold-skills present — leaving skills untouched)"
        held=$((held + 1))
        continue
    fi

    tmpl="$(head -n1 "$home/.seeded" 2>/dev/null | tr -d '[:space:]')"
    [ -n "$tmpl" ] || tmpl=researcher

    # Links into the store: every tick. Workspace clones fetch only on a full run.
    if [ -x "$LINK" ]; then
        if [ "$sources_changed" -eq 1 ] || [ "$FORCE" -eq 1 ]; then
            "$LINK" "$name" --sources "$SOURCES" --fetch --verbose >/dev/null || log "link-skills failed for $name"
        elif [ "$full" -eq 1 ]; then
            "$LINK" "$name" --sources "$SOURCES" --verbose >/dev/null || log "link-skills failed for $name"
        else
            "$LINK" "$name" --sources "$SOURCES" >/dev/null || log "link-skills failed for $name"
        fi
    fi
    if [ "$full" -eq 0 ]; then continue; fi

    src="$REPO/user-templates/$tmpl/.claude/skills"
    dst="$home/.claude/skills"
    bk="$home/.go-jupyter/refresh-backups/$TS/.claude/skills"
    mkdir -p "$dst" "$bk"
    # Transitional template skills (if the template still has any): per skill
    # directory, and never over a link. Absence of the directory is the end state.
    if [ -d "$src" ]; then
        for sd in "$src"/*/; do
            [ -d "$sd" ] || continue
            sk="$(basename "$sd")"
            [ -L "$dst/$sk" ] && continue
            rsync -a --delete --backup --backup-dir="$bk/$sk" "$sd" "$dst/$sk/"
            chown -R "$name:$name" "$dst/$sk"
        done
    fi
    chown -R "$name:$name" "$home/.go-jupyter"

    # News — same hard-mirror contract as skills. The per-user "have they seen
    # this yet" marker deliberately lives OUTSIDE this directory
    # (~/.go-jupyter/news-seen), because --delete would otherwise wipe it on
    # every sync and every user would be re-shown the same announcement.
    news_src="$REPO/user-templates/$tmpl/news"
    if [ -d "$news_src" ]; then
        news_dst="$home/.go-jupyter/news"
        mkdir -p "$news_dst"
        rsync -a --delete "$news_src/" "$news_dst/"
        chown -R "$name:$name" "$news_dst"
    fi
    # Drop the backup tree again if this run superseded nothing.
    find "$home/.go-jupyter/refresh-backups/$TS" -type d -empty -delete 2>/dev/null || true
    mirrored=$((mirrored + 1))
done < <(getent passwd)

printf '%s' "$newstate" > "$STATE"
[ "$full" -eq 0 ] || log "run done: users=$mirrored held=$held"
