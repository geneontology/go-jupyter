[Unit]
Description=go-jupyter: periodically archive transcripts and forward turns to Langfuse
Documentation=https://github.com/geneontology/go-jupyter/issues/28

[Timer]
# First run shortly after boot, then every 5 minutes. A tick is one rsync per
# account plus one hook process per transcript that changed since the last
# tick (an idle session bumps its transcript's mtime, so an idle session costs
# one short hook run per tick that emits nothing). Overlapping runs skip on
# the script's lock.
OnBootSec=10min
OnUnitActiveSec=5min
Persistent=true

[Install]
WantedBy=timers.target
